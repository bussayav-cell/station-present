<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Entech EV Station Packages</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,500;0,600;0,700;1,600;1,700&family=IBM+Plex+Sans+Thai:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap">
<style>
/* Layout: fixed 1920×1080 stage scaled to the viewport; black field cut by the brand's diagonal green slashes */
:root{
  --bg:#060807; --panel:#0d1210; --panel-2:#121916; --line:#22302a;
  --fg:#eef3f0; --muted:#8fa199; --dim:#5d6d66;
  --green:#1fd68f; --green-2:#0b9e66; --green-ink:#02160d;
  --sc:#f26a1b; --sg:#2f8cff;
  --f-disp:"Chakra Petch","Segoe UI",Tahoma,sans-serif;
  --f-body:"IBM Plex Sans Thai","Leelawadee UI","Noto Sans Thai",Tahoma,sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
  color-scheme:dark;
}
html,body{height:100%;margin:0;background:var(--bg);color:var(--fg);overflow:hidden}
body{font-family:var(--f-body);-webkit-font-smoothing:antialiased}
button{font:inherit;color:inherit}
.deck{position:fixed;inset:0;display:grid;place-items:center;overflow:hidden;background:var(--bg)}
.stage{position:absolute;left:50%;top:50%;width:1920px;height:1080px;transform-origin:0 0;overflow:hidden;background:var(--bg)}
.slide{position:absolute;inset:0;padding:96px 110px 120px;box-sizing:border-box;opacity:0;visibility:hidden;transform:translateX(60px);transition:opacity .55s ease,transform .7s cubic-bezier(.2,.8,.2,1),visibility 0s linear .7s}
.slide.active{opacity:1;visibility:visible;transform:none;transition:opacity .55s ease .1s,transform .7s cubic-bezier(.2,.8,.2,1) .1s,visibility 0s}
.slide.past{transform:translateX(-60px)}

/* entrance choreography */
.slide [data-a]{opacity:1}
.slide.active [data-a]{animation:rise .8s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(var(--d,0)*1s + .15s)}
.slide.active [data-a="l"]{animation-name:fromLeft}
.slide.active [data-a="s"]{animation-name:scaleIn}
@keyframes rise{from{opacity:0;transform:translateY(34px)}to{opacity:1;transform:none}}
@keyframes fromLeft{from{opacity:0;transform:translateX(-60px)}to{opacity:1;transform:none}}
@keyframes scaleIn{from{opacity:0;transform:scale(.92)}to{opacity:1;transform:none}}

/* brand slashes */
.slashes{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.slashes i{position:absolute;top:-10%;height:120%;background:linear-gradient(180deg,var(--green) 0%,var(--green-2) 55%,rgba(11,158,102,0) 100%);transform:skewX(-16deg);opacity:.9}
.slide.active .slashes i{animation:slash 1.1s cubic-bezier(.2,.8,.2,1) both}
.slashes i:nth-child(1){right:-120px;width:230px;animation-delay:.05s}
.slashes i:nth-child(2){right:170px;width:70px;opacity:.55;animation-delay:.18s}
.slashes i:nth-child(3){right:290px;width:3px;opacity:.6;background:var(--fg);animation-delay:.3s}
@keyframes slash{from{transform:skewX(-16deg) translateX(520px);opacity:0}to{transform:skewX(-16deg);opacity:var(--o,.9)}}
.slashes.soft i{opacity:.22}
.slashes.soft i:nth-child(2){opacity:.12}

/* type */
.eyebrow{font-family:var(--f-mono);font-size:20px;letter-spacing:.14em;text-transform:uppercase;color:var(--green)}
h1,h2,h3{font-family:var(--f-disp);margin:0;text-wrap:balance;line-height:1.02}
h2{font-size:76px;font-weight:700;letter-spacing:-.01em}
h3{font-size:34px;font-weight:600}
p{margin:0}
.lead{font-size:30px;line-height:1.5;color:var(--muted);max-width:30em}
.mono{font-family:var(--f-mono)}
.num{font-family:var(--f-disp);font-style:italic;font-weight:700;font-variant-numeric:tabular-nums}

.chip{display:inline-flex;align-items:center;gap:10px;height:42px;padding:0 18px;border-radius:999px;border:1.5px solid var(--line);font-size:20px;font-weight:500;color:var(--fg);white-space:nowrap}
.chip.sc{border-color:color-mix(in srgb,var(--sc) 70%,transparent);color:#ffb38a}
.chip.sc::before,.chip.sg::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--sc)}
.chip.sg{border-color:color-mix(in srgb,var(--sg) 70%,transparent);color:#9cc8ff}
.chip.sg::before{background:var(--sg)}
.chip.ty{background:var(--panel-2)}

/* ---------- COVER ---------- */
.s-cover{padding:0}
.s-cover .gl-host{position:absolute;inset:0}
.cover-shade{position:absolute;inset:0;background:linear-gradient(90deg,var(--bg) 0%,rgba(6,8,7,.92) 30%,rgba(6,8,7,.35) 60%,rgba(6,8,7,0) 80%),linear-gradient(0deg,var(--bg) 0%,rgba(6,8,7,0) 30%);pointer-events:none}
.cover-text{position:absolute;left:110px;top:120px;width:960px;display:flex;flex-direction:column;gap:34px;pointer-events:none}
.cover-text .brandline{display:flex;align-items:center;gap:22px;font-size:24px;color:var(--muted)}
.cover-text .brandline b{color:var(--fg);font-weight:600;font-family:var(--f-disp);font-size:28px;letter-spacing:.04em}
.cover-text .brandline span{width:90px;height:2px;background:var(--green)}
.cover-title{font-family:var(--f-disp);font-weight:700;line-height:.86;letter-spacing:-.02em}
.cover-title .ev{display:block;font-style:italic;font-size:110px;color:var(--green);font-weight:600}
.cover-title .big{display:block;font-size:210px;color:var(--fg)}
.cover-title .sub{display:block;font-size:64px;color:var(--fg);letter-spacing:.06em;margin-top:22px;font-weight:600}
.cover-meta{display:flex;gap:46px;margin-top:10px}
.cover-meta div{display:flex;flex-direction:column;gap:6px}
.cover-meta .num{font-size:72px;color:var(--green);line-height:1}
.cover-meta small{font-size:22px;color:var(--muted)}
.cover-hint{position:absolute;right:120px;bottom:130px;font-size:20px;color:var(--muted);display:flex;align-items:center;gap:14px;pointer-events:none}
.cover-hint i{width:12px;height:12px;border-radius:50%;background:var(--green);box-shadow:0 0 0 0 var(--green);animation:pulse 2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(31,214,143,.6)}100%{box-shadow:0 0 0 18px rgba(31,214,143,0)}}

/* ---------- OVERVIEW ---------- */
.ov-head{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;margin-bottom:26px}
.ladder{display:flex;flex-direction:column;gap:4px}
.rung{display:grid;grid-template-columns:220px 150px 1fr;align-items:center;gap:28px;padding:10px 0;border-top:1px solid var(--line)}
.rung .kw{font-size:56px;line-height:1;color:var(--fg)}
.rung .kw small{font-size:26px;font-style:normal;color:var(--muted);margin-left:6px}
.rung .tr{font-size:20px;color:var(--muted);line-height:1.3}
.rung .tr b{display:block;font-family:var(--f-disp);font-size:30px;color:var(--fg);font-weight:600}
.rung .opts{display:flex;flex-wrap:wrap;gap:8px;position:relative}
.ochip{display:inline-flex;align-items:center;gap:12px;height:44px;padding:0 18px 0 8px;border-radius:12px;background:var(--panel-2);border:1px solid var(--line);font-size:20px;cursor:pointer;transition:border-color .2s,transform .2s,background .2s}
.ochip:hover,.ochip:focus-visible{border-color:var(--green);transform:translateY(-3px);background:#16211c;outline:none}
.ochip .n{font-family:var(--f-mono);font-size:18px;background:var(--green);color:var(--green-ink);border-radius:8px;padding:6px 9px;font-weight:500}
.ochip .n.sg{background:var(--sg);color:#fff}
.ochip em{font-style:normal;color:var(--muted)}

/* ---------- ARCHITECTURE ---------- */
.arch-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:34px;margin-top:54px}
.arch{background:var(--panel);border:1px solid var(--line);border-radius:22px;padding:34px;display:flex;flex-direction:column;gap:22px}
.arch svg{width:100%;height:220px;display:block}
.arch h3{font-size:36px}
.arch .who{font-size:20px;color:var(--muted)}
.arch ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:12px;font-size:22px;line-height:1.45}
.arch li{display:grid;grid-template-columns:22px 1fr;gap:12px}
.arch li::before{content:"";width:12px;height:12px;margin-top:10px;background:var(--green);transform:skewX(-16deg)}
.arch li.minus::before{background:var(--dim)}
.flow{stroke:var(--green);stroke-width:4;fill:none;stroke-dasharray:10 12;animation:flow 1.2s linear infinite}
@keyframes flow{to{stroke-dashoffset:-44}}
.svg-box{fill:var(--panel-2);stroke:#3a4a43;stroke-width:2}
.svg-t{fill:var(--fg);font-family:var(--f-body);font-size:18px}
.svg-s{fill:var(--muted);font-family:var(--f-mono);font-size:14px}

/* ---------- LINEUP ---------- */
.lineup{display:flex;gap:30px;margin-top:44px;height:690px}
.lgroup{display:flex;flex-direction:column;gap:16px;min-width:0;flex:var(--n) 1 0}
.lgroup header{display:flex;align-items:center;gap:14px;font-size:22px;color:var(--muted);padding-bottom:12px;border-bottom:2px solid var(--line)}
.lgroup header b{color:var(--fg);font-family:var(--f-disp);font-weight:600;font-size:26px}
.lcards{display:flex;gap:16px;flex:1}
.mcard{flex:1 1 0;min-width:0;background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:16px 16px 18px;display:flex;flex-direction:column;gap:10px;cursor:pointer;text-align:left;transition:transform .3s cubic-bezier(.2,.8,.2,1),border-color .2s}
.mcard:hover,.mcard:focus-visible{transform:translateY(-10px);border-color:var(--green);outline:none}
.mcard .ph{height:330px;display:grid;place-items:center;background:radial-gradient(ellipse at 50% 85%,#1a2620 0%,transparent 70%);border-radius:12px}
.mcard img{max-height:310px;max-width:100%;object-fit:contain;filter:drop-shadow(0 18px 22px rgba(0,0,0,.55));transition:transform .5s}
.mcard:hover img{transform:scale(1.05)}
.mcard .nm{font-family:var(--f-disp);font-weight:600;font-size:21px;line-height:1.15;min-height:2.3em}
.mcard .pw{font-size:40px;color:var(--green);line-height:1}
.mcard .pw small{font-size:18px;color:var(--muted);font-style:normal}
.mcard .ty{font-size:17px;color:var(--muted)}
.mcard .more{margin-top:auto;font-family:var(--f-mono);font-size:15px;color:var(--green)}

/* modal */
.modal{position:absolute;inset:0;background:rgba(3,5,4,.78);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;z-index:50;opacity:0;pointer-events:none;transition:opacity .3s}
.modal.open{opacity:1;pointer-events:auto}
.mbox{width:1380px;max-height:880px;background:var(--panel);border:1px solid var(--line);border-radius:26px;display:grid;grid-template-columns:440px 1fr;overflow:hidden;transform:translateY(30px) scale(.97);transition:transform .45s cubic-bezier(.2,.8,.2,1)}
.modal.open .mbox{transform:none}
.mbox .mimg{background:radial-gradient(ellipse at 50% 80%,#1c2a23,var(--panel-2) 70%);display:grid;place-items:center;padding:40px}
.mbox .mimg img{max-height:620px;object-fit:contain;filter:drop-shadow(0 24px 30px rgba(0,0,0,.6))}
.mbox .mtxt{padding:46px 50px;display:flex;flex-direction:column;gap:20px;overflow:auto}
.mbox h3{font-size:48px}
.mbox .feat{display:flex;flex-wrap:wrap;gap:10px}
.mbox .feat span{background:var(--panel-2);border:1px solid var(--line);border-radius:10px;padding:8px 14px;font-size:19px}
.spec{width:100%;border-collapse:collapse;font-size:20px}
.spec td{padding:11px 0;border-bottom:1px solid var(--line);vertical-align:top}
.spec td:first-child{color:var(--muted);width:36%;padding-right:20px}
.mclose{position:absolute;top:30px;right:34px;width:60px;height:60px;border-radius:50%;border:1px solid var(--line);background:var(--panel);cursor:pointer;font-size:30px;line-height:1}
.mclose:hover{border-color:var(--green)}
.src{font-size:16px;color:var(--dim)}

/* ---------- TIER ---------- */
.s-tier{display:grid;grid-template-columns:660px 1fr;gap:60px}
.tier-l{display:flex;flex-direction:column;gap:22px;position:relative;z-index:1}
.tier-kw{font-size:240px;line-height:.85;color:var(--green);letter-spacing:-.03em}
.tier-kw small{font-size:110px;color:var(--fg);font-style:normal;margin-left:12px}
.tier-sub{display:flex;gap:16px;flex-wrap:wrap}
.tier-sub .chip{height:50px;font-size:22px}
.tier-pics{margin-top:auto;display:flex;align-items:flex-end;gap:22px;height:300px}
.tier-pics img{max-height:290px;max-width:190px;object-fit:contain;filter:drop-shadow(0 20px 24px rgba(0,0,0,.6))}
.slide.active .tier-pics img{animation:floatIn 1s cubic-bezier(.2,.8,.2,1) both}
@keyframes floatIn{from{opacity:0;transform:translateY(60px)}to{opacity:1;transform:none}}
.tier-r{display:flex;flex-direction:column;gap:14px;justify-content:center;position:relative;z-index:1;padding-right:150px;min-width:0}
.tier-r.dense{gap:8px}
.tier-r.dense .trow{padding:11px 22px}
.tier-r.dense .trow .c{font-size:23px}
.tier-r.dense .trow .c small{font-size:16px;margin-top:2px}
.tier-r.dense .trow .n{font-size:36px}
.tier-r.dense .trow .m b{font-size:28px}
.trow{display:grid;grid-template-columns:90px 1fr auto;gap:24px;align-items:center;padding:20px 26px;background:rgba(13,18,16,.88);border:1px solid var(--line);border-radius:18px;cursor:pointer;text-align:left;transition:border-color .2s,transform .25s}
.trow:hover,.trow:focus-visible{border-color:var(--green);transform:translateX(8px);outline:none}
.trow .n{font-family:var(--f-disp);font-style:italic;font-weight:700;font-size:46px;color:var(--green)}
.trow .n.sg{color:var(--sg)}
.trow .c{font-family:var(--f-disp);font-weight:600;font-size:28px;line-height:1.15}
.trow .c small{display:block;font-family:var(--f-body);font-weight:400;font-size:19px;color:var(--muted);margin-top:4px}
.trow .m{display:flex;gap:26px;text-align:right}
.trow .m div{display:flex;flex-direction:column}
.trow .m b{font-family:var(--f-disp);font-size:36px;font-weight:600;line-height:1}
.trow .m span{font-size:16px;color:var(--muted)}
.dots{display:flex;flex-wrap:wrap;gap:4px;width:150px;justify-content:flex-end}
.dots i{width:9px;height:9px;border-radius:2px;background:var(--green)}

/* ---------- OPTION ---------- */
.s-opt{display:grid;grid-template-columns:740px 1fr;gap:56px;padding-top:80px}
.opt-l{display:flex;flex-direction:column;gap:22px;min-width:0}
.opt-l .tags{display:flex;gap:12px;flex-wrap:wrap}
.opt-title{font-size:54px;font-weight:700}
.opt-title .x{color:var(--green)}
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.kpi{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:16px 18px;display:flex;flex-direction:column;gap:6px}
.kpi .lb{font-size:17px;color:var(--muted)}
.kpi b{font-family:var(--f-disp);font-style:italic;font-weight:700;font-size:50px;line-height:1;font-variant-numeric:tabular-nums}
.kpi b small{font-style:normal;font-size:19px;color:var(--muted);margin-left:4px;font-weight:500}
.kpi.hot{background:var(--green);border-color:var(--green);color:var(--green-ink)}
.kpi.hot .lb,.kpi.hot b small{color:#0b3d27}
.load{display:flex;flex-direction:column;gap:10px;font-size:19px;color:var(--muted)}
.load .bar{height:14px;border-radius:7px;background:var(--panel-2);position:relative;overflow:hidden;border:1px solid var(--line)}
.load .bar i{position:absolute;inset:0 auto 0 0;background:linear-gradient(90deg,var(--green-2),var(--green));border-radius:7px;width:var(--w)}
.slide.active .load .bar i{animation:grow 1.4s cubic-bezier(.2,.8,.2,1) .5s both}
@keyframes grow{from{width:0}}
.load .row{display:flex;justify-content:space-between}
.load .row b{color:var(--fg);font-weight:600}
.hl{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:14px}
.hl li{display:grid;grid-template-columns:44px 1fr;gap:14px;align-items:start;font-size:22px;line-height:1.42}
.hl li svg{width:44px;height:44px}
.fit{margin-top:auto;font-size:21px;line-height:1.45;padding:18px 22px;border-left:5px solid var(--green);background:linear-gradient(90deg,rgba(31,214,143,.10),transparent)}
.fit b{color:var(--green);font-weight:600;margin-right:8px}

.opt-r{position:relative;display:flex;flex-direction:column;gap:16px;min-width:0}
.vtabs{display:flex;gap:8px;align-self:flex-start;background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:6px;position:relative;z-index:2}
.vtabs button{height:52px;padding:0 26px;border-radius:999px;border:0;background:transparent;cursor:pointer;font-size:21px;font-weight:500;color:var(--muted);display:flex;align-items:center;gap:10px;transition:background .25s,color .25s}
.vtabs button.on{background:var(--green);color:var(--green-ink)}
.vtabs button:focus-visible{outline:2px solid var(--green);outline-offset:2px}
.vtabs svg{width:24px;height:24px}
.viewport{position:relative;flex:1;perspective:2200px}
.face{position:absolute;inset:0;border-radius:26px;overflow:hidden;border:1px solid var(--line);background:#0a0e0c;transition:transform .9s cubic-bezier(.2,.8,.2,1),opacity .6s;backface-visibility:hidden;transform-origin:50% 50%}
.face.off{transform:rotateY(-70deg) translateZ(-260px) scale(.9);opacity:0;pointer-events:none}
.face.f3d .gl-host{position:absolute;inset:0}
.f3d .hint{position:absolute;left:24px;bottom:22px;font-size:17px;color:var(--muted);background:rgba(6,8,7,.75);padding:8px 14px;border-radius:10px;pointer-events:none}
.f3d .legend{position:absolute;right:22px;top:22px;display:flex;flex-direction:column;gap:8px;font-size:17px;background:rgba(6,8,7,.78);border:1px solid var(--line);padding:14px 18px;border-radius:14px;pointer-events:none}
.legend div{display:flex;align-items:center;gap:10px}
.legend i{width:22px;height:5px;border-radius:3px;background:var(--green);box-shadow:0 0 10px var(--green)}
.legend i.box{width:14px;height:14px;border-radius:3px;background:#0f5f3f;box-shadow:none}
.legend i.tr{width:14px;height:14px;border-radius:3px;background:#5b6b62;box-shadow:none}
.nogl{position:absolute;inset:0;display:grid;place-items:center;color:var(--muted);font-size:22px;text-align:center;padding:40px}

.fmc{display:flex;align-items:stretch;justify-content:center;gap:20px;padding:40px 44px;background:radial-gradient(ellipse at 50% 100%,#14201a 0%,#0a0e0c 70%)}
.part{flex:1;display:flex;flex-direction:column;align-items:center;gap:12px;min-width:0;text-align:center}
.part .pimg{flex:1;display:flex;align-items:flex-end;justify-content:center;min-height:0;position:relative;width:100%}
.part img{max-height:100%;max-width:100%;object-fit:contain;filter:drop-shadow(0 26px 26px rgba(0,0,0,.65))}
.face:not(.off) .part img{animation:bob 5s ease-in-out infinite}
.part:nth-child(3) img{animation-delay:-2.5s}
@keyframes bob{50%{transform:translateY(-12px)}}
.part .qty{position:absolute;top:0;right:8%;font-family:var(--f-disp);font-style:italic;font-weight:700;font-size:80px;color:var(--green);line-height:1}
.part .pn{font-family:var(--f-disp);font-weight:600;font-size:30px}
.part .pr{font-size:18px;color:var(--muted)}
.part .pchips{display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
.part .pchips span{font-size:17px;border:1px solid var(--line);background:var(--panel);border-radius:8px;padding:6px 10px}
.arrow{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:var(--green);font-family:var(--f-mono);font-size:16px;flex:none;width:90px;text-align:center}
.arrow svg{width:80px;height:30px}
.arrow .flow{stroke-width:5}

/* ---------- COMPARE ---------- */
.tbl-wrap{margin-top:18px;border:1px solid var(--line);border-radius:20px;overflow:hidden}
table.cmp{width:100%;border-collapse:collapse;font-size:17px;font-variant-numeric:tabular-nums}
.cmp th{font-family:var(--f-mono);font-weight:500;font-size:14px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);text-align:left;padding:9px 16px;background:var(--panel-2)}
.cmp td{padding:3px 16px;border-top:1px solid var(--line)}
.cmp tr.r{cursor:pointer;transition:background .15s}
.cmp tr.r:hover,.cmp tr.r:focus-visible{background:#13201a;outline:none}
.cmp td.n{font-family:var(--f-disp);font-weight:700;font-style:italic;color:var(--green);font-size:19px}
