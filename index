    box(g,w+.04,.1,d+.04,M.gray,0,.05,0); box(g,w,h-.1,d,M.white,0,h/2+.05,0);
    if(big){ box(g,.5,.55,.012,M.dark,-.33,.55,d/2+.01,false); box(g,.5,.55,.012,M.dark,.33,.55,d/2+.01,false); box(g,.01,h-.3,.012,M.gray,0,h/2,d/2+.01,false);}
    else box(g,.62,.5,.012,M.dark,0,.5,d/2+.01,false);
    box(g,.012,.16,.012,M.led,-w/2+.18,1.3,d/2+.015,false);
    return g;
  }
  function mTR(){
    const g=new THREE.Group();
    box(g,3.0,.2,2.4,M.pad,0,.1,0);
    box(g,1.9,1.6,1.25,M.tr,0,1.0,0);
    for(let i=0;i<9;i++){const x=-.8+i*.2; box(g,.04,1.2,.3,M.trfin,x,.95,.78); box(g,.04,1.2,.3,M.trfin,x,.95,-.78)}
    for(let i=0;i<3;i++){const c=new THREE.Mesh(new THREE.CylinderGeometry(.07,.09,.45,10),M.gray); c.position.set(-.5+i*.5,2.02,0); c.castShadow=true; g.add(c)}
    box(g,1.95,.06,1.3,M.yellow,0,1.83,0,false);
    return g;
  }
  function mCar(ci){
    const g=new THREE.Group(), body=CARC[ci%CARC.length];
    box(g,1.86,.5,4.5,body,0,.55,0); box(g,1.8,.22,4.3,M.dark,0,.3,0);
    const cab=box(g,1.62,.52,2.5,M.carGlass,0,1.05,.25);
    box(g,1.64,.06,2.3,body,0,1.33,.3);
    [[.88,1.45],[-.88,1.45],[.88,-1.45],[-.88,-1.45]].forEach(([x,z])=>{const w=new THREE.Mesh(new THREE.CylinderGeometry(.34,.34,.24,14),M.tire); w.rotation.z=Math.PI/2; w.position.set(x,.34,z); w.castShadow=true; g.add(w)});
    box(g,.4,.06,.03,M.head,.6,.62,-2.26,false); box(g,.4,.06,.03,M.head,-.6,.62,-2.26,false);
    return g;
  }
  const MAKE={jv5:()=>mJupiter(),tv5180:()=>mTitan(false),tv5240:()=>mTitan(false),tv5pro:()=>mTitan(true),hydrus:()=>mHydrus(),idc480:()=>mIDC(),idc360:()=>mIDC(),sgdisp:()=>mSGdisp(),novav5:()=>mNova(false),novav4:()=>mNova(true)};

  function ribbon(pts,wd,op){
    const pos=[],uv=[],idx=[]; let u=0;
    for(let i=0;i<pts.length-1;i++){
      const a=pts[i],b=pts[i+1]; const dx=b[0]-a[0],dz=b[1]-a[1],L=Math.hypot(dx,dz); if(L<1e-4) continue;
      const nx=-dz/L*wd/2,nz=dx/L*wd/2, ex=dx/L*wd/2, ez=dz/L*wd/2; const base=pos.length/3;
      const ax=a[0]-ex,az=a[1]-ez,bx=b[0]+ex,bz=b[1]+ez;
      pos.push(ax+nx,0,az+nz, ax-nx,0,az-nz, bx+nx,0,bz+nz, bx-nx,0,bz-nz);
      uv.push(u*.55,0,u*.55,1,(u+L)*.55,0,(u+L)*.55,1); u+=L;
      idx.push(base,base+1,base+2,base+1,base+3,base+2);
    }
    const geo=new THREE.BufferGeometry(); geo.setAttribute("position",new THREE.Float32BufferAttribute(pos,3)); geo.setAttribute("uv",new THREE.Float32BufferAttribute(uv,2)); geo.setIndex(idx);
    const m=new THREE.MeshBasicMaterial({map:dashTex,color:0xffffff,transparent:true,opacity:0,blending:THREE.AdditiveBlending,depthWrite:false});
    m.userData.op=op||1; dashMats.push(m);
    const o=new THREE.Mesh(geo,m); o.position.y=.03; o.renderOrder=2; return o;
  }

  function disposeRoot(){
    if(!root) return;
    root.traverse(o=>{ if(o.geometry) o.geometry.dispose(); if(o.material&&(o.isSprite||dashMats.includes(o.material))){ if(o.material.map&&o.material.map!==dashTex) o.material.map.dispose(); o.material.dispose(); } });
    scene.remove(root); root=null; dashMats=[]; anims=[];
  }

  function build(opt){
    disposeRoot();
    root=new THREE.Group(); scene.add(root);
    // charge points & cabinets
    const cabs=[], pts=[]; let cabKey=null;
    opt.parts.forEach(([k,q])=>{ for(let i=0;i<q;i++) (MACH[k].role==="cab"?cabs:pts).push({k}) });
    if(cabs.length) cabKey=cabs[0].k;
    // Sungrow: interleave IDC and its dispenser
    if(opt.fam==="sgc"){ const idcs=pts.filter(p=>MACH[p.k].role==="point"), ds=pts.filter(p=>MACH[p.k].role==="disp"); pts.length=0; idcs.forEach((p,i)=>{pts.push(p); if(ds[i]){ds[i].feed=p; pts.push(ds[i])}}) }
    else if(cabs.length){ pts.forEach((p,i)=>p.cab=i%cabs.length); pts.sort((a,b)=>a.cab-b.cab) }
    const n=pts.length, rows=n>6?2:1, per=Math.ceil(n/rows), SP=5.6, BAY=2.8, L=per*SP;
    const trench = rows===2 ? -.8 : -1.15;
    const rowGroups=[];
    for(let r=0;r<rows;r++){ const rg=new THREE.Group(); if(r===1){rg.rotation.y=Math.PI; rg.position.z=-1.6} root.add(rg); rowGroups.push(rg) }
    let carI=0;
    pts.forEach((p,i)=>{
      const r=rows===2?(i<per?0:1):0, j=rows===2?(i<per?i:i-per):i, cnt=rows===2?(r===0?per:n-per):n;
      const x=(j-(cnt-1)/2)*SP; const rg=rowGroups[r];
      const u=MAKE[p.k](); u.position.set(x,0,0); rg.add(u);
      // island kerb
      box(rg,1.9,.14,1.25,M.pad,x,.07,0,false);
      [ -1,1 ].forEach((s,bi)=>{
        const bx=x+s*BAY/2;
        const bay=new THREE.Mesh(new THREE.PlaneGeometry(BAY-.25,5.3),M.bay); bay.rotation.x=-Math.PI/2; bay.position.set(bx,.012,.8+2.65); bay.receiveShadow=true; rg.add(bay);
        const ln=new THREE.Mesh(new THREE.PlaneGeometry(.09,5.5),M.line); ln.rotation.x=-Math.PI/2; ln.position.set(bx+s*BAY/2,.014,.8+2.75); rg.add(ln);
        box(rg,1.2,.1,.18,M.yellow,bx,.05,1.35,false);
        const seed=(i*2+bi)*7%10;
        if(seed<6){ const c=mCar(carI++); c.position.set(bx,0,.8+2.6+.2); rg.add(c); anims.push({o:c,t:"car",d:1.1+carI*.07,b:c.position.z}) }
      });
      p.world=new THREE.Vector3(x,0,-.5); rg.updateMatrixWorld(true); p.world.applyMatrix4(rg.matrixWorld);
      anims.push({o:u,t:"rise",d:.45+i*.06});
    });
    // canopies
    rowGroups.forEach((rg,r)=>{
      const cnt=rows===2?(r===0?per:n-per):n, Lr=cnt*SP, x0=-Lr/2-.4, x1=Lr/2+.4, z0=-.2, z1=6.6, H=5.3;
      const cg=new THREE.Group(); rg.add(cg);
      const gl=new THREE.Mesh(new THREE.BoxGeometry(x1-x0,.06,z1-z0),M.glass); gl.position.set(0,H,(z0+z1)/2); cg.add(gl);
      box(cg,x1-x0,.32,.32,M.canopy,0,H,z1); box(cg,x1-x0,.32,.32,M.canopy,0,H,z0);
      box(cg,.32,.32,z1-z0,M.canopy,x0,H,(z0+z1)/2); box(cg,.32,.32,z1-z0,M.canopy,x1,H,(z0+z1)/2);
      box(cg,x1-x0,.06,.04,M.led,0,H-.12,z1+.17,false);
      for(let k=0;k<=cnt;k++){ const x=-Lr/2+k*SP; if(k%2===0||k===cnt){ box(cg,.26,H,.26,M.canopy,Math.max(x0+.1,Math.min(x1-.1,x)),H/2,z0+.05) } if(k<cnt) box(cg,.24,.24,z1-z0,M.canopy,-Lr/2+(k+.5)*SP,H-.02,(z0+z1)/2,false) }
      anims.push({o:cg,t:"drop",d:.25});
    });
    // power yard
    const minX=-L/2-1.4;
    const cabX=k=>minX-2.2-k*2.1;
    const trX=cabs.length? cabX(cabs.length-1)-3.4 : minX-3.2;
    const yardZ = trench-.2;
    const tr=mTR(); tr.position.set(trX,0,yardZ); root.add(tr); anims.push({o:tr,t:"rise",d:0});
    const yardW=Math.abs(trX-minX)+3.4;
    const yp=new THREE.Mesh(new THREE.PlaneGeometry(yardW,5.2),M.padL); yp.rotation.x=-Math.PI/2; yp.position.set((trX+minX)/2-.2,.006,yardZ); yp.receiveShadow=true; root.add(yp);
    // fence
    const fx0=trX-1.9,fx1=minX+.6,fz0=yardZ-2.4,fz1=yardZ+2.4;
    const fm=new THREE.MeshStandardMaterial({color:0x8a9590,transparent:true,opacity:.18,side:THREE.DoubleSide,depthWrite:false});
    [[fx0,fz0,fx1,fz0],[fx0,fz1,fx1,fz1],[fx0,fz0,fx0,fz1]].forEach(([a,b,c,d])=>{const L2=Math.hypot(c-a,d-b); const pl=new THREE.Mesh(new THREE.PlaneGeometry(L2,1.8),fm); pl.position.set((a+c)/2,.9,(b+d)/2); pl.rotation.y=-Math.atan2(d-b,c-a); root.add(pl); box(root,.06,1.9,.06,M.gray,a,.95,b,false); box(root,.06,1.9,.06,M.gray,c,.95,d,false)});
    dashMats.push(fm); fm.userData.op=.18; fm.userData.static=true;
    const cabObjs=cabs.map((c,k)=>{const o=MAKE[c.k](); o.position.set(cabX(k),0,yardZ); o.rotation.y=Math.PI/2; root.add(o); anims.push({o,t:"rise",d:.18+k*.08}); return o});
    // energy ribbons
    const Y=[];
    const add=(p,w,op)=>{const rb=ribbon(p,w,op); root.add(rb); Y.push(rb)};
    if(cabs.length){
      cabs.forEach((c,k)=>add([[trX+1,yardZ],[cabX(k),yardZ]],.34,1));
      pts.forEach((p,i)=>{ const cx=cabX(p.cab), off=(p.cab-(cabs.length-1)/2)*.22; add([[cx,yardZ],[cx+.9,trench+off],[p.world.x,trench+off],[p.world.x,p.world.z]],.16,.85) });
    } else {
      pts.forEach((p,i)=>{ if(p.feed) return; add([[trX+1,yardZ],[trX+2.2,trench],[p.world.x,trench],[p.world.x,p.world.z]],.2,.9) });
      pts.forEach(p=>{ if(p.feed) add([[p.feed.world.x,p.feed.world.z],[p.feed.world.x,trench+.25],[p.world.x,trench+.25],[p.world.x,p.world.z]],.16,.85) });
    }
    // labels
    const l1=label(`หม้อแปลง ${opt.tr} kVA`); l1.position.set(trX,3.4,yardZ); root.add(l1);
    if(cabs.length){ const l2=label(`${MACH[cabKey].name} × ${cabs.length}`,`ตู้ไฟกลาง ${opt.st} kW`); l2.position.set((cabX(0)+cabX(cabs.length-1))/2,3.6,yardZ); root.add(l2) }
    const l3=label(`${opt.st} kW · ${opt.o} หัว`,opt.cfg.length>28?opt.arch:opt.cfg); l3.position.set(0,7.3,rows===2?-.8:2.8); root.add(l3);
    // fit
    const x0=trX-2.5, x1=L/2+1.5, z0=rows===2?-8.5:-3.2, z1=7.2;
    const cx=(x0+x1)/2, cz=(z0+z1)/2, span=Math.max(x1-x0,(z1-z0)*1.25);
    t0=performance.now(); builtFor=opt.n;
    root.userData={cx,cz,span};
    dirL.target.position.set(cx,0,cz); dirL.position.set(cx-22,38,cz+26);
    const sc=dirL.shadow.camera, ext=span*.75+6; sc.left=-ext; sc.right=ext; sc.top=ext; sc.bottom=-ext; sc.near=1; sc.far=140; sc.updateProjectionMatrix();
    frame();
  }
  function frame(){
    if(!root) return; const {cx,cz,span}=root.userData; const a=cam.aspect||1.4;
    const vf=cam.fov*Math.PI/180, hf=2*Math.atan(Math.tan(vf/2)*a);
    let dist=(span/2)/Math.tan(hf/2)*.66; dist=Math.max(dist,(span*.3)/Math.tan(vf/2)); dist=Math.max(dist,14);
    const k=hostEl&&hostEl.closest(".s-cover")?.78:1;
    ctl.target.set(cx+(k<1?-span*.08:0),.8,cz);
    cam.position.set(cx+dist*.55*k,dist*.52*k,cz+dist*.78*k);
    ctl.minDistance=8; ctl.maxDistance=dist*1.8; ctl.update();
  }
  function resize(){
    if(!hostEl) return; const w=hostEl.clientWidth||800,h=hostEl.clientHeight||600;
    R.setPixelRatio(Math.min(2,(devicePixelRatio||1)*scale)+.0001);
    R.setSize(w,h,false); cam.aspect=w/h; cam.updateProjectionMatrix();
  }
  let lastS=null;
  if(document.fonts&&document.fonts.ready) document.fonts.ready.then(()=>{ if(lastS){ builtFor=null; mountFor(lastS) } });
  function mountFor(s){
    lastS=s;
    const h=s.el.querySelector(".gl-host"); if(!h){hostEl=null;return}
    hostEl=h; if(R.domElement.parentNode!==h) h.appendChild(R.domElement);
    const o=OPTS.find(x=>x.n===s.gl);
    resize();
    if(builtFor!==o.n) build(o); else { t0=performance.now()-3000; frame() }
    ctl.autoRotateSpeed = s.id==="cover"?.35:.55;
  }
  const ease=k=>1-Math.pow(1-Math.min(1,Math.max(0,k)),3);
  function loop(now){
    requestAnimationFrame(loop);
    if(!hostEl||!active||document.hidden) return;
    const vis=hostEl.closest(".slide.active"); if(!vis) return;
    const t=(now-t0)/1000;
    for(const a of anims){
      const k=reduce?1:ease((t-a.d)/.8);
      if(a.t==="rise") a.o.position.y=(1-k)*-3;
      else if(a.t==="drop"){ a.o.position.y=(1-k)*4; }
      else if(a.t==="car") a.o.position.z=a.b+(1-k)*9;
    }
    dashTex.offset.x = reduce?0:-(now/1000)*.9;
    const fk=reduce?1:ease((t-.9)/1);
    dashMats.forEach(m=>m.opacity=m.userData.op*(m.userData.static?1:fk));
    const pulse=1.6+Math.sin(now/420)*.8; ledMats.forEach(m=>m.emissiveIntensity=pulse);
    ctl.update(); R.render(scene,cam);
  }
  requestAnimationFrame(loop);
  return {mountFor,resize,setActive(v){active=v}};
})();

